{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kefyusuf/assurectl/schemas/receipt.v0.schema.json",
  "title": "AssureCTL Receipt v0",
  "description": "Unstable unsigned v0 receipt schema. It carries no authoritative cryptographic claim.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "authority",
    "subject",
    "work_unit",
    "contract",
    "policy",
    "evidence",
    "requirement_results",
    "findings",
    "waivers",
    "verification_verdict",
    "completion_decision",
    "verifier",
    "evaluated_at"
  ],
  "properties": {
    "schema_version": {
      "const": "assurectl/receipt/v0"
    },
    "authority": {
      "type": "string",
      "enum": [
        "ADVISORY",
        "CI_ASSERTED",
        "AUTHORITATIVE"
      ]
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository_uri",
        "base_revision",
        "head_revision",
        "change_set_algorithm",
        "change_set_digest"
      ],
      "properties": {
        "repository_uri": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "base_revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
        },
        "head_revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
        },
        "change_set_algorithm": {
          "const": "assurectl.git-change-set/v0"
        },
        "change_set_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "work_unit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "objective"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "enum": [
            "pull_request",
            "commit",
            "release_candidate",
            "api_migration",
            "sdk_migration",
            "framework_upgrade",
            "dependency_upgrade",
            "security_remediation"
          ]
        },
        "objective": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "contract": {
      "$ref": "#/$defs/digested_input"
    },
    "policy": {
      "$ref": "#/$defs/resolved_policy"
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence_reference"
      }
    },
    "requirement_results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/requirement_result"
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "waivers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/waiver_record"
      }
    },
    "verification_verdict": {
      "type": "string",
      "enum": [
        "PASSED",
        "FAILED",
        "INDETERMINATE"
      ]
    },
    "completion_decision": {
      "type": "string",
      "enum": [
        "APPROVED",
        "REJECTED",
        "BLOCKED",
        "ACCEPTED_WITH_RISK"
      ]
    },
    "verifier": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "protocol_version"
      ],
      "properties": {
        "name": {
          "const": "assurectl"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "protocol_version": {
          "const": "v0"
        }
      }
    },
    "evaluated_at": {
      "$ref": "#/$defs/rfc3339_timestamp"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "verification_verdict": {
            "const": "PASSED"
          }
        },
        "required": [
          "verification_verdict"
        ]
      },
      "then": {
        "properties": {
          "completion_decision": {
            "const": "APPROVED"
          }
        },
        "required": [
          "completion_decision"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "verification_verdict": {
            "const": "INDETERMINATE"
          }
        },
        "required": [
          "verification_verdict"
        ]
      },
      "then": {
        "properties": {
          "completion_decision": {
            "const": "BLOCKED"
          }
        },
        "required": [
          "completion_decision"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "verification_verdict": {
            "const": "FAILED"
          }
        },
        "required": [
          "verification_verdict"
        ]
      },
      "then": {
        "properties": {
          "completion_decision": {
            "enum": [
              "REJECTED",
              "BLOCKED",
              "ACCEPTED_WITH_RISK"
            ]
          }
        },
        "required": [
          "completion_decision"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "completion_decision": {
            "const": "APPROVED"
          }
        },
        "required": [
          "completion_decision"
        ]
      },
      "then": {
        "properties": {
          "requirement_results": {
            "items": {
              "properties": {
                "evidence_state": {
                  "const": "VALID"
                },
                "outcome": {
                  "const": "PASSED"
                }
              },
              "required": [
                "evidence_state",
                "outcome"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "authority": {
            "const": "AUTHORITATIVE"
          },
          "completion_decision": {
            "not": {
              "const": "BLOCKED"
            }
          }
        },
        "required": [
          "authority",
          "completion_decision"
        ]
      },
      "then": {
        "properties": {
          "contract": {
            "type": "object",
            "properties": {
              "trust_status": {
                "const": "TRUSTED"
              }
            },
            "required": [
              "trust_status"
            ]
          },
          "policy": {
            "type": "object",
            "properties": {
              "trust_status": {
                "const": "TRUSTED"
              }
            },
            "required": [
              "trust_status"
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "digest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "value"
      ],
      "properties": {
        "algorithm": {
          "const": "sha256"
        },
        "value": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "rfc3339_timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]+)?(Z|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$",
      "description": "RFC3339 timestamp. The pattern is a lexical assertion; ingestion MUST parse the value and reject impossible calendar values. Time-order constraints are validated semantically."
    },
    "trust_status": {
      "type": "string",
      "enum": [
        "TRUSTED",
        "UNTRUSTED",
        "UNRESOLVED"
      ]
    },
    "digested_input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "digest",
        "trust_status"
      ],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "trust_status": {
          "$ref": "#/$defs/trust_status"
        }
      }
    },
    "policy_source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "layer",
        "source",
        "digest",
        "trust_status",
        "authority_basis"
      ],
      "properties": {
        "layer": {
          "type": "string",
          "enum": [
            "protocol_baseline",
            "organization",
            "project",
            "assurance_profile",
            "work_unit_contract"
          ]
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "trust_status": {
          "$ref": "#/$defs/trust_status"
        },
        "authority_basis": {
          "type": "string",
          "enum": [
            "BUILTIN",
            "TRUSTED_BASE",
            "PROTECTED_CONTROL_PLANE",
            "APPROVED_CONTRACT",
            "ADVISORY_WORKSPACE",
            "CANDIDATE_HEAD"
          ]
        },
        "source_revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "authority_basis": {
                "enum": [
                  "TRUSTED_BASE",
                  "CANDIDATE_HEAD"
                ]
              }
            },
            "required": [
              "authority_basis"
            ]
          },
          "then": {
            "required": [
              "source_revision"
            ]
          }
        }
      ]
    },
    "resolved_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sources",
        "effective_digest",
        "trust_status"
      ],
      "properties": {
        "sources": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/policy_source"
          }
        },
        "effective_digest": {
          "$ref": "#/$defs/digest"
        },
        "trust_status": {
          "$ref": "#/$defs/trust_status"
        }
      }
    },
    "evidence_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "digest"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "category",
        "severity",
        "message",
        "blocking"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "type": "string",
          "enum": [
            "SUBJECT",
            "CONTRACT",
            "POLICY",
            "EVIDENCE",
            "VERIFICATION",
            "WAIVER",
            "AUTHORITY",
            "PROTOCOL",
            "INTERNAL"
          ]
        },
        "severity": {
          "type": "string",
          "enum": [
            "INFO",
            "WARNING",
            "ERROR"
          ]
        },
        "requirement_id": {
          "type": "string",
          "minLength": 1
        },
        "evidence_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "blocking": {
          "type": "boolean"
        }
      }
    },
    "waiver_target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "REQUIREMENT",
            "FINDING"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "waiver_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository_uri",
        "work_unit_id"
      ],
      "properties": {
        "repository_uri": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "work_unit_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "head_revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
        }
      }
    },
    "waiver_approver": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "authority"
      ],
      "properties": {
        "identity": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "authority": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "description": "Verifier-resolved approver authority. A waiver payload cannot establish this trust by self-declaration."
        }
      }
    },
    "waiver_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "target",
        "scope",
        "reason",
        "accepted_risk",
        "approver",
        "issued_at",
        "expires_at",
        "status",
        "digest"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "target": {
          "$ref": "#/$defs/waiver_target"
        },
        "scope": {
          "$ref": "#/$defs/waiver_scope"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "accepted_risk": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "approver": {
          "$ref": "#/$defs/waiver_approver"
        },
        "issued_at": {
          "$ref": "#/$defs/rfc3339_timestamp"
        },
        "expires_at": {
          "$ref": "#/$defs/rfc3339_timestamp"
        },
        "status": {
          "type": "string",
          "enum": [
            "VALID",
            "INVALID"
          ]
        },
        "digest": {
          "$ref": "#/$defs/digest",
          "description": "Digest of the normalized waiver input recorded by the verifier; it is not a signature or trust root."
        }
      }
    },
    "requirement_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirement_id",
        "evidence_state",
        "waivable",
        "waiver_status"
      ],
      "properties": {
        "requirement_id": {
          "type": "string",
          "minLength": 1
        },
        "evidence_state": {
          "type": "string",
          "enum": [
            "VALID",
            "INVALID",
            "MISSING",
            "STALE",
            "UNTRUSTED"
          ]
        },
        "outcome": {
          "type": "string",
          "enum": [
            "PASSED",
            "FAILED",
            "ERROR"
          ]
        },
        "waivable": {
          "type": "boolean"
        },
        "waiver_status": {
          "type": "string",
          "enum": [
            "NOT_APPLICABLE",
            "VALID",
            "INVALID"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "evidence_state": {
                "const": "VALID"
              }
            },
            "required": [
              "evidence_state"
            ]
          },
          "then": {
            "required": [
              "outcome"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "waiver_status": {
                "const": "VALID"
              }
            },
            "required": [
              "waiver_status"
            ]
          },
          "then": {
            "properties": {
              "waivable": {
                "const": true
              },
              "evidence_state": {
                "const": "VALID"
              },
              "outcome": {
                "const": "FAILED"
              }
            },
            "required": [
              "waivable",
              "evidence_state",
              "outcome"
            ]
          }
        }
      ]
    }
  }
}
