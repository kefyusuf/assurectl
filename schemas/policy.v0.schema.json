{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kefyusuf/assurectl/schemas/policy.v0.schema.json",
  "title": "AssureCTL Policy v0",
  "description": "Unstable v0 project-policy schema for advisory development use.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "requirements"
  ],
  "properties": {
    "schema_version": {
      "const": "assurectl/policy/v0"
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "evidence_type",
          "waivable",
          "allowed_producer_types"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          },
          "evidence_type": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "waivable": {
            "type": "boolean"
          },
          "allowed_producer_types": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          "max_age_seconds": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}
