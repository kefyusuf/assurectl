{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kefyusuf/assurectl/schemas/evidence-envelope.v0.schema.json",
  "title": "AssureCTL Evidence Envelope v0",
  "description": "Unstable v0 evidence metadata. Integrity alone does not establish trusted provenance.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "type",
    "subject",
    "producer",
    "invocation",
    "outcome",
    "artifact"
  ],
  "properties": {
    "schema_version": {
      "const": "assurectl/evidence-envelope/v0"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "type": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository_uri",
        "revision"
      ],
      "properties": {
        "repository_uri": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
        }
      }
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "identity"
      ],
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "identity": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "workflow": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "workflow_revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
        }
      }
    },
    "invocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command_id",
        "started_at",
        "finished_at"
      ],
      "properties": {
        "command_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "environment_digest": {
          "$ref": "#/$defs/digest"
        },
        "started_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]+)?(Z|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$",
          "description": "RFC3339 timestamp. The pattern is a lexical assertion; ingestion MUST also parse the value with an RFC3339 parser and reject impossible calendar values."
        },
        "finished_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]+)?(Z|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$",
          "description": "RFC3339 timestamp. The pattern is a lexical assertion; ingestion MUST also parse the value with an RFC3339 parser and reject impossible calendar values."
        }
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "PASSED",
            "FAILED",
            "ERROR"
          ]
        },
        "exit_code": {
          "type": "integer"
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uri",
        "digest",
        "media_type"
      ],
      "properties": {
        "uri": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "media_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "value"
      ],
      "properties": {
        "algorithm": {
          "const": "sha256"
        },
        "value": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
